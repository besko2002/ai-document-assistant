# Copy to .env.local and fill in real values. .env / .env.local are git-ignored.

# --- AI providers ---
# Google Gemini free API key (required to call the chat model).
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_CHAT_MODEL=gemini-3.8-flash

# Optional fallback provider, used when Gemini is rate-limited (Phase 3).
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# --- Database (matches docker-compose.yml) ---
DB_URL=jdbc:postgresql://localhost:5436/docassistant
DB_USERNAME=doc
DB_PASSWORD=doc
DB_POOL_SIZE=10

# --- Server ---
SERVER_PORT=8090
LOG_LEVEL_APP=INFO

# --- Uploads ---
MAX_FILE_SIZE=25MB
MAX_REQUEST_SIZE=25MB

# --- Reserved for Phase 2 (auth) ---
JWT_SECRET=
